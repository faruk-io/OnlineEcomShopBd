# Copy to .env (git-ignored) and replace every placeholder. Never commit .env.
# Values are interpolated by docker compose: avoid  $  ;  "  '  and spaces in them.

# SQL Server 'sa' password. Policy: >= 8 chars, 3 of 4 classes (upper, lower, digit, symbol).
#   generate:  echo "Tb-$(openssl rand -hex 12)-Aa1"
MSSQL_SA_PASSWORD=change-me-Aa1-generate-with-openssl

# JWT signing key, >= 32 chars:   openssl rand -base64 48 | tr -d '+/=\n'
JWT_KEY=change-me-generate-with-openssl-rand-base64-48

# Key that encrypts two-step-verification secrets (base64, >= 32 bytes):   openssl rand -base64 32
# Optional here (Development derives one from JWT_KEY); REQUIRED in production. Losing/changing it invalidates every enrolment.
MFA_SECRET_KEY=

# Password of the seeded admin (admin@techbazar.bd), strong, >= 10 chars:   openssl rand -hex 12
SEED_ADMIN_PASSWORD=change-me-generate-with-openssl
