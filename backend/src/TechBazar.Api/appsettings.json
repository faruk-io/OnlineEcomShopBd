{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TechBazarBD",
    "Audience": "TechBazarBD.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "RateLimiting": { "Auth": { "PermitLimit": 10, "WindowSeconds": 60 }, "Public": { "PermitLimit": 60 } },
  "OutputCache": { "CatalogSeconds": 60, "AutocompleteSeconds": 30 },
  "Shipping": { "InsideDhakaFee": 70, "OutsideDhakaFee": 130, "PickupFee": 0, "StoreName": "TechBazar BD Store", "StoreAddress": "Store address placeholder, Dhaka" },
  "Payments": { "PublicApiBaseUrl": "http://localhost:5080", "StorefrontBaseUrl": "http://localhost:4200" },
  "SslCommerz": { "IsSandbox": true },
  "Storage": { "RequestPath": "/uploads" },
  "Seed": { "Enabled": false, "ApplyMigrations": false }
}
